{
  "name": "jsl-ui-plugin",
  "version": "1.0.1",
  "description": "为集思录带来现代化界面的 Chrome 扩展",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "audit:code": "node scripts/audit.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "preview:calendar-data": "node scripts/refresh-calendar-events.mjs"
  },
  "keywords": [
    "chrome-extension",
    "userscript",
    "dark-theme",
    "jisilu",
    "manifest-v3"
  ],
  "author": "jim",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jluncc/jsl-ui-plugin.git"
  },
  "homepage": "https://github.com/jluncc/jsl-ui-plugin#readme",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "private": true,
  "type": "module"
}
