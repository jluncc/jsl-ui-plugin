{
  "manifest_version": 3,
  "name": "JSL Polish · 集思录现代化",
  "version": "0.2.1",
  "description": "为集思录社区带来现代化界面：深浅双主题、现代排版与更舒适的阅读体验",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "JSL Polish 设置"
  },
  "content_scripts": [
    {
      "matches": ["https://www.jisilu.cn/*"],
      "js": ["scripts/content.js"],
      "css": ["styles/tokens.css", "styles/global.css", "styles/community.css"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
